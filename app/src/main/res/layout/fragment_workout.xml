<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:context=".ui.WorkoutFragment">

    <LinearLayout
        android:id="@+id/header_container"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="20dp"
        android:background="#F5F2EC"
        app:layout_constraintTop_toTopOf="parent"
        android:elevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/icon_header"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/logo"
                android:layout_marginEnd="12dp"
                app:tint="#2563EB" />

            <TextView
                android:id="@+id/text_workout_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Workouts"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111827"
            android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_workout_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stay consistent, stay strong 💪"
            android:textSize="15sp"
            android:textColor="#4B5563"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif" />

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:background="#2563EB"
            android:alpha="0.8"
            android:layout_marginTop="16dp" />
    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_workouts"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="16dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        app:layout_constraintTop_toBottomOf="@id/header_container"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/row_workout" />

</androidx.constraintlayout.widget.ConstraintLayout>
